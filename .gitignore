# Test artifacts and dependencies (generated, not needed in the repo)
node_modules/
test/*.png
test/ingame/
test/fixtures/
package-lock.json

# test scratch
test/cl/
test/*.log
test/_*.mjs
test/*.mp3
test/_commitmsg.txt

# Voice/TTS generation tooling + model weights now live in the SIBLING project
# E:\projects\voiceAIGeneration (see its CLAUDE.md). Only the generated clips
# (games/**/voice/*.wav) are bundled here. These weight patterns are kept just in case.
*.onnx
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# Packed voice "sprites" + manifest are GENERATED from the raw per-clip wavs by
# tools/pack-voice.js (run in the CD pipeline, or locally before serving). The raw
# games/**/voice/<set>/*.wav stay in the repo as the source of truth.
games/**/voice/packed/

# Content hashes for the MEDIA tier — GENERATED by tools/build-asset-manifest.mjs, which hashes the
# packed voice above, so it cannot be reproduced from a clean checkout until pack-voice has run. The
# deploy rebuilds it (after pack-voice, before staging), same as the generated sw-<name>.js workers.
assets.json

# online server runtime data (lifetime scores + the SQLite database)
server/scores.json
server/data/
server/*.db
server/*.db-journal
server/*.legacy.bak

# local deploy staging (tools/deploy-azure.ps1)
_deploy/
deploy.zip

# generated sub-hub service workers (tools/gen-subhub.js)
/sw-*.js
