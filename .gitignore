# ROMs must never be pushed (copyright) — keep them local only
roms/

# Test artifacts and dependencies (generated, not needed in the repo)
node_modules/
test/*.png
test/ingame/
test/fixtures/
package-lock.json

# test scratch
test/cl/
test/*.log
test/_*.mjs
test/*.mp3
test/_commitmsg.txt

# local AI/TTS model weights — used at BUILD time only (e.g. on-GPU voice generation).
# Never commit or deploy them; only the generated clips (games/**/voice/*.mp3) are bundled.
tools/models/
*.onnx
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# online server runtime data (lifetime scores + the SQLite database)
server/scores.json
server/data/
server/*.db
server/*.db-journal
server/*.legacy.bak
